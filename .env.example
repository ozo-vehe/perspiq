# Vercel AI Gateway authentication is automatic in v0 previews and Vercel deployments.
# If using a direct provider locally, configure the corresponding gateway credentials.
AI_API_KEY=

# PayPal sandbox credentials. Keep the secret server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_RETURN_URL=http://localhost:3000/subscribe
PAYPAL_CANCEL_URL=http://localhost:3000/subscribe
